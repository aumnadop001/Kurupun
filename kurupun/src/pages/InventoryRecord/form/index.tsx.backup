import React, { useState, useEffect } from 'react';
import { useNavigate, useParams, useSearchParams } from 'react-router-dom';

import Container from '@mui/material/Container';
import Paper from '@mui/material/Paper';
import TextField from '@mui/material/TextField';
import Button from '@mui/material/Button';
import Typography from '@mui/material/Typography';
import Box from '@mui/material/Box';
import Stack from '@mui/material/Stack';
import Alert from '@mui/material/Alert';
import Divider from '@mui/material/Divider';
import Autocomplete from '@mui/material/Autocomplete';
import Table from '@mui/material/Table';
import TableBody from '@mui/material/TableBody';
import TableCell from '@mui/material/TableCell';
import TableContainer from '@mui/material/TableContainer';
import TableHead from '@mui/material/TableHead';
import TableRow from '@mui/material/TableRow';
import IconButton from '@mui/material/IconButton';
import DeleteIcon from '@mui/icons-material/Delete';
import AddIcon from '@mui/icons-material/Add';

import toast from 'react-hot-toast';
import { useAuth } from '../../../hooks/useAuth';
import { createInventoryRecord, updateInventoryRecord, fetchInventoryRecordById } from '../../../apis/service/inventory';
import { fetchDocumentRegistries } from '../../../apis/service/documentRegistry';

interface DocumentRegistry {
  id: number;
  registry_number: string;
  document_title: string;
  registration_date: string;
}

interface InventoryRecordFormData {
  // เกณฑ์การสั่ง
  order_criteria: string;
  reorder_point: string;
  safety_stock: string;
  related_equipment: string;
  remark: string;
  
  // ค้างรับ และ ค้างจ่าย (ซ้าย)
  doc_date_left: string;
  evidence_left: string;
  unit_left: string;
  qty_left: string;
  pending_receive_1: string;
  pending_receive_2: string;
  pending_receive_3: string;
  pending_receive_4: string;
  
  // ความต้องการรับและจ่าย (ขวา)
  doc_date_right: string;
  received_qty: string;
  price_per_unit: string;
  evidence_right: string;
  demand_initial: string;
  demand_replace: string;
  issued_qty: string;
  total_borrowed: string;
  stock_balance: string;
  signature: string;
}

const emptyRecord: InventoryRecordFormData = {
  order_criteria: '',
  reorder_point: '',
  safety_stock: '',
  related_equipment: '',
  remark: '',
  doc_date_left: '',
  evidence_left: '',
  unit_left: '',
  qty_left: '',
  pending_receive_1: '',
  pending_receive_2: '',
  pending_receive_3: '',
  pending_receive_4: '',
  doc_date_right: '',
  received_qty: '',
  price_per_unit: '',
  evidence_right: '',
  demand_initial: '',
  demand_replace: '',
  issued_qty: '',
  total_borrowed: '',
  stock_balance: '',
  signature: '',
};

const FormInventoryRecord: React.FC = () => {
  const navigate = useNavigate();
  const { id } = useParams();
  const [searchParams] = useSearchParams();
  const { isAuthenticated } = useAuth();
  const isEditMode = !!id && isAuthenticated;
  const isViewMode = !!id && !isAuthenticated;
  
  const [documentRegistries, setDocumentRegistries] = useState<DocumentRegistry[]>([]);
  const [selectedDocumentRegistry, setSelectedDocumentRegistry] = useState<DocumentRegistry | null>(null);
  
  const [formData, setFormData] = useState<InventoryRecordFormData>({
    document_registry: null,
    order_criteria: '',
    reorder_point: '',
    safety_stock: '',
    related_equipment: '',
    remark: '',
    doc_date_left: '',
    evidence_left: '',
    unit_left: '',
    qty_left: '',
    pending_receive_1: '',
    pending_receive_2: '',
    pending_receive_3: '',
    pending_receive_4: '',
    doc_date_right: '',
    received_qty: '',
    price_per_unit: '',
    evidence_right: '',
    demand_initial: '',
    demand_replace: '',
    issued_qty: '',
    total_borrowed: '',
    stock_balance: '',
    signature: '',
  });

  // Fetch document registries for dropdown
  useEffect(() => {
    const fetchRegistries = async () => {
      try {
        const response = await fetchDocumentRegistries({ page_size: 1000 });
        setDocumentRegistries(response.results || []);
        
        // Check if document_registry is passed via query parameter
        const documentRegistryId = searchParams.get('document_registry');
        if (documentRegistryId && response.results) {
          const preSelectedDoc = response.results.find(
            (doc: DocumentRegistry) => doc.id === parseInt(documentRegistryId)
          );
          if (preSelectedDoc) {
            setSelectedDocumentRegistry(preSelectedDoc);
            setFormData(prev => ({
              ...prev,
              document_registry: preSelectedDoc.id,
            }));
          }
        }
      } catch (error) {
        console.error("Error fetching document registries:", error);
        toast.error('ไม่สามารถโหลดรายการทะเบียนเอกสารได้');
      }
    };
    fetchRegistries();
  }, [searchParams]);

  // Fetch existing data in edit mode
  useEffect(() => {
    if (isEditMode) {
      const fetchData = async () => {
        try {
          const data = await fetchInventoryRecordById(id);
          setFormData({
            document_registry: data.document_registry,
            order_criteria: data.order_criteria || '',
            reorder_point: data.reorder_point || '',
            safety_stock: data.safety_stock || '',
            related_equipment: data.related_equipment || '',
            remark: data.remark || '',
            doc_date_left: data.doc_date_left || '',
            evidence_left: data.evidence_left || '',
            unit_left: data.unit_left || '',
            qty_left: data.qty_left?.toString() || '',
            pending_receive_1: data.pending_receive_1?.toString() || '',
            pending_receive_2: data.pending_receive_2?.toString() || '',
            pending_receive_3: data.pending_receive_3?.toString() || '',
            pending_receive_4: data.pending_receive_4?.toString() || '',
            doc_date_right: data.doc_date_right || '',
            received_qty: data.received_qty?.toString() || '',
            price_per_unit: data.price_per_unit?.toString() || '',
            evidence_right: data.evidence_right || '',
            demand_initial: data.demand_initial?.toString() || '',
            demand_replace: data.demand_replace?.toString() || '',
            issued_qty: data.issued_qty?.toString() || '',
            total_borrowed: data.total_borrowed?.toString() || '',
            stock_balance: data.stock_balance?.toString() || '',
            signature: data.signature || '',
          });
          
          // Find and set selected document registry
          const selectedDoc = documentRegistries.find(doc => doc.id === data.document_registry);
          if (selectedDoc) {
            setSelectedDocumentRegistry(selectedDoc);
          }
        } catch (error) {
          console.error("Error fetching inventory record:", error);
          toast.error('ไม่สามารถโหลดข้อมูลได้');
        }
      };
      fetchData();
    }
  }, [id, isEditMode, documentRegistries]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData((prev) => ({
      ...prev,
      [name]: value,
    }));
  };

  const handleDocumentRegistryChange = (_event: any, value: DocumentRegistry | null) => {
    setSelectedDocumentRegistry(value);
    setFormData((prev) => ({
      ...prev,
      document_registry: value?.id || null,
    }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!formData.document_registry) {
      toast.error('กรุณาเลือกทะเบียนเอกสาร');
      return;
    }

    try {
      // Convert string values to appropriate types
      const submitData = {
        ...formData,
        qty_left: formData.qty_left ? parseInt(formData.qty_left) : null,
        pending_receive_1: formData.pending_receive_1 ? parseInt(formData.pending_receive_1) : null,
        pending_receive_2: formData.pending_receive_2 ? parseInt(formData.pending_receive_2) : null,
        pending_receive_3: formData.pending_receive_3 ? parseInt(formData.pending_receive_3) : null,
        pending_receive_4: formData.pending_receive_4 ? parseInt(formData.pending_receive_4) : null,
        received_qty: formData.received_qty ? parseInt(formData.received_qty) : null,
        price_per_unit: formData.price_per_unit ? parseFloat(formData.price_per_unit) : null,
        demand_initial: formData.demand_initial ? parseInt(formData.demand_initial) : null,
        demand_replace: formData.demand_replace ? parseInt(formData.demand_replace) : null,
        issued_qty: formData.issued_qty ? parseInt(formData.issued_qty) : null,
        total_borrowed: formData.total_borrowed ? parseInt(formData.total_borrowed) : null,
        stock_balance: formData.stock_balance ? parseInt(formData.stock_balance) : null,
      };

      if (isEditMode) {
        await updateInventoryRecord(id, submitData);
        toast.success('แก้ไขข้อมูลสำเร็จ');
      } else {
        await createInventoryRecord(submitData);
        toast.success('เพิ่มข้อมูลสำเร็จ');
      }
      navigate('/inventory-records');
    } catch (error) {
      console.error('Error saving inventory record:', error);
      toast.error('เกิดข้อผิดพลาดในการบันทึกข้อมูล');
    }
  };

  const handleCancel = () => {
    navigate('/inventory-records');
  };

  const handleEdit = () => {
    navigate('/login', { state: { from: `/inventory-records/${id}` } });
  };

  return (
    <Container maxWidth="xl" sx={{ mt: 4, mb: 4 }}>
      <Paper elevation={3} sx={{ p: 4 }}>
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
          <Typography variant="h4" component="h1">
            {isEditMode ? 'แก้ไขบันทึกรายการพัสดุ' : isViewMode ? 'รายละเอียดบันทึกรายการพัสดุ' : 'เพิ่มบันทึกรายการพัสดุ'}
          </Typography>
          {isViewMode && (
            <Button
              variant="contained"
              color="primary"
              onClick={handleEdit}
              size="large"
            >
              เข้าสู่ระบบเพื่อแก้ไข
            </Button>
          )}
        </Box>

        {isViewMode && (
          <Alert severity="info" sx={{ mb: 3 }}>
            คุณกำลังดูข้อมูลในโหมดอ่านอย่างเดียว กรุณาเข้าสู่ระบบเพื่อแก้ไขข้อมูล
          </Alert>
        )}

        <Box component="form" onSubmit={handleSubmit} sx={{ mt: 3 }}>
          <Stack spacing={3}>
            {/* รายการ (Document Registry) */}
            <Box>
              <Typography variant="h6" sx={{ mb: 2 }}>รายการ (ทะเบียนเอกสาร)</Typography>
              <Autocomplete
                value={selectedDocumentRegistry}
                onChange={handleDocumentRegistryChange}
                options={documentRegistries}
                getOptionLabel={(option) => `${option.registry_number} - ${option.document_title}`}
                renderInput={(params) => (
                  <TextField
                    {...params}
                    label="เลือกทะเบียนเอกสาร"
                    required={!isViewMode}
                    disabled={isViewMode}
                  />
                )}
                disabled={isViewMode}
                isOptionEqualToValue={(option, value) => option.id === value.id}
              />
            </Box>

            <Divider />

            {/* เกณฑ์การสั่ง */}
            <Box>
              <Typography variant="h6" sx={{ mb: 2 }}>เกณฑ์การสั่ง</Typography>
              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap', mb: 2 }}>
                <Box sx={{ flex: '1 1 30%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="เกณฑ์สั่ง"
                    name="order_criteria"
                    value={formData.order_criteria}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 30%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="จุดสั่งเพิ่มเติม"
                    name="reorder_point"
                    value={formData.reorder_point}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 30%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="เกณฑ์ปลอดภัย"
                    name="safety_stock"
                    value={formData.safety_stock}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>
            </Box>

            <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap' }}>
              <Box sx={{ flex: '1 1 45%', minWidth: '250px' }}>
                <TextField
                  fullWidth
                  label="ครุภัณฑ์ที่เกี่ยวข้อง"
                  name="related_equipment"
                  value={formData.related_equipment}
                  onChange={handleChange}
                  multiline
                  rows={3}
                  disabled={isViewMode}
                  InputProps={{ readOnly: isViewMode }}
                />
              </Box>
              <Box sx={{ flex: '1 1 45%', minWidth: '250px' }}>
                <TextField
                  fullWidth
                  label="หมายเหตุ"
                  name="remark"
                  value={formData.remark}
                  onChange={handleChange}
                  multiline
                  rows={3}
                  disabled={isViewMode}
                  InputProps={{ readOnly: isViewMode }}
                />
              </Box>
            </Box>

            <Divider />

            {/* ค้างรับ และ ค้างจ่าย */}
            <Box>
              <Typography variant="h6" sx={{ mb: 2 }}>ค้างรับ และ ค้างจ่าย</Typography>
              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap', mb: 2 }}>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ว.ด.ป."
                    name="doc_date_left"
                    type="date"
                    value={formData.doc_date_left}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputLabelProps={{ shrink: true }}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="หลักฐาน"
                    name="evidence_left"
                    value={formData.evidence_left}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="หน่วย"
                    name="unit_left"
                    value={formData.unit_left}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="จำนวน"
                    name="qty_left"
                    type="number"
                    value={formData.qty_left}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>

              <Typography variant="subtitle1" sx={{ mt: 2, mb: 1 }}>รับค้าง</Typography>
              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap' }}>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รับค้าง 1"
                    name="pending_receive_1"
                    type="number"
                    value={formData.pending_receive_1}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รับค้าง 2"
                    name="pending_receive_2"
                    type="number"
                    value={formData.pending_receive_2}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รับค้าง 3"
                    name="pending_receive_3"
                    type="number"
                    value={formData.pending_receive_3}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รับค้าง 4"
                    name="pending_receive_4"
                    type="number"
                    value={formData.pending_receive_4}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>
            </Box>

            <Divider />

            {/* ความต้องการรับและจ่าย */}
            <Box>
              <Typography variant="h6" sx={{ mb: 2 }}>ความต้องการรับและจ่าย</Typography>
              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap', mb: 2 }}>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ว.ด.ป."
                    name="doc_date_right"
                    type="date"
                    value={formData.doc_date_right}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputLabelProps={{ shrink: true }}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รับ"
                    name="received_qty"
                    type="number"
                    value={formData.received_qty}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ราคาต่อหน่วย"
                    name="price_per_unit"
                    type="number"
                    inputProps={{ step: "0.01" }}
                    value={formData.price_per_unit}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="หลักฐาน"
                    name="evidence_right"
                    value={formData.evidence_right}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>

              <Typography variant="subtitle1" sx={{ mt: 2, mb: 1 }}>ความต้องการ</Typography>
              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap', mb: 2 }}>
                <Box sx={{ flex: '1 1 45%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ขั้นต้น"
                    name="demand_initial"
                    type="number"
                    value={formData.demand_initial}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 45%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ทดแทน"
                    name="demand_replace"
                    type="number"
                    value={formData.demand_replace}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>

              <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap' }}>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="จ่าย"
                    name="issued_qty"
                    type="number"
                    value={formData.issued_qty}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="รวมยืม"
                    name="total_borrowed"
                    type="number"
                    value={formData.total_borrowed}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="คงคลัง"
                    name="stock_balance"
                    type="number"
                    value={formData.stock_balance}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
                <Box sx={{ flex: '1 1 22%', minWidth: '200px' }}>
                  <TextField
                    fullWidth
                    label="ลายมือชื่อ"
                    name="signature"
                    value={formData.signature}
                    onChange={handleChange}
                    disabled={isViewMode}
                    InputProps={{ readOnly: isViewMode }}
                  />
                </Box>
              </Box>
            </Box>

            {/* Buttons */}
            {!isViewMode && (
              <Box sx={{ display: 'flex', gap: 2, justifyContent: 'flex-end', mt: 3 }}>
                <Button
                  variant="outlined"
                  color="secondary"
                  onClick={handleCancel}
                  size="large"
                >
                  ยกเลิก
                </Button>
                <Button
                  type="submit"
                  variant="contained"
                  color="primary"
                  size="large"
                >
                  {isEditMode ? 'บันทึกการแก้ไข' : 'เพิ่มบันทึก'}
                </Button>
              </Box>
            )}

            {isViewMode && (
              <Box sx={{ display: 'flex', gap: 2, justifyContent: 'flex-end', mt: 3 }}>
                <Button
                  variant="outlined"
                  color="secondary"
                  onClick={handleCancel}
                  size="large"
                >
                  กลับ
                </Button>
              </Box>
            )}
          </Stack>
        </Box>
      </Paper>
    </Container>
  );
};

export default FormInventoryRecord;
